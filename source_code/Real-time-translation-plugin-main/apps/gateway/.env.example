HOST=127.0.0.1
PORT=8787

# Use a separate random secret for extension -> local gateway authentication.
GATEWAY_CLIENT_TOKEN=change-me

# Use "fake" for offline UI tests or "aliyun-gummy" for real subtitles.
SPEECH_PROVIDER=aliyun-gummy

# Create this key in Alibaba Cloud Model Studio, China (Beijing) region.
DASHSCOPE_API_KEY=
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
# Optional when the key belongs to the default workspace.
DASHSCOPE_WORKSPACE_ID=
GUMMY_MODEL=gummy-realtime-v1
# Gummy accepts 200-6000 ms. A lower value finalizes subtitles sooner but may split sentences more often.
GUMMY_MAX_END_SILENCE_MS=500
